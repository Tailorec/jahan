# Jahan runtime configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Everything here is execution configuration: it changes how fast a study runs,
# never which world it records, so no hash covers it (simcore/inference/_settings.py).
# Model pins, prices, temperatures and templates are study inputs and stay out
# of this file — they are hashed into the run. Keys are never typed into the browser.

# --- The one gateway the engine talks to -------------------------------------
# OpenAI Chat Completions + Embeddings over HTTP. Default points at a local
# LiteLLM proxy (docs/getting-started/real-models.md step 4).
SIMCORE_INFERENCE_BASE_URL=http://127.0.0.1:4000/v1
# OPENAI_BASE_URL=              # fallback name, read when the line above is unset
SIMCORE_INFERENCE_API_KEY=
# OPENAI_API_KEY=               # fallback name; Bedrock setups use AWS_* below instead

# --- Pace of requests (lower these when the provider throttles) --------------
SIMCORE_INFERENCE_CONCURRENCY=32
SIMCORE_INFERENCE_QUEUE_BOUND=4096
# SIMCORE_INFERENCE_REQUESTS_PER_MINUTE=
# SIMCORE_INFERENCE_TOKENS_PER_MINUTE=

# --- Retries: the engine owns them, the gateway translates --------------------
SIMCORE_INFERENCE_TIMEOUT_S=90.0
SIMCORE_INFERENCE_MAX_RETRIES=3
SIMCORE_INFERENCE_BACKOFF_BASE_S=0.5
SIMCORE_INFERENCE_BACKOFF_CAP_S=20.0
SIMCORE_INFERENCE_CIRCUIT_THRESHOLD=5
SIMCORE_INFERENCE_EMBEDDINGS_BATCH_SIZE=64

# --- Models the server pins by default ----------------------------------------
SIMCORE_CHAT_MODEL=amazon.nova-micro-v1:0
SIMCORE_EMBED_MODEL=amazon.titan-embed-text-v2:0

# --- Caches (inference responses, corpus shards, matrices, indexes) -----------
# SIMCORE_CACHE_DIR=            # unset: ~/.cache/simcore/inference; corpus under ~/.cache
# XDG_CACHE_HOME=               # base dir honoured when SIMCORE_CACHE_DIR is unset

# --- Telemetry -----------------------------------------------------------------
# SIMCORE_OTEL_CAPTURE_CONTENT=  # set to 1/true/yes to include message bodies in spans

# --- Web interface (read once at `npm run dev` start; restart after changing) --
SIMCORE_WEB_URL=http://127.0.0.1:8000

# --- Provider credentials, behind the gateway only ------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# HF_TOKEN=                   # corpus download only (`hf download`), never read by the engine
